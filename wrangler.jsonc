{
  // Cloudflare Workers: site estatico + API de reservas. Deploy automatico a cada push na branch main.
  "name": "iguacu-executive-transfer",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // O site responde so no dominio oficial. Os enderecos de teste das versoes (preview) recebem "noindex" pelo Worker.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // "none" mantem as URLs .html exatamente como hoje (sem redirecionar /pagina.html para /pagina)
    "html_handling": "none",
    "not_found_handling": "404-page",
    // o Worker atende tudo: a API (/api/...) e repassa o resto para os arquivos do site
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "iet-reservas", "database_id": "c113f678-3e0f-4caa-af30-e41cfe39784e" }
  ],
  "send_email": [
    { "name": "AVISOS", "destination_address": "atendimento@g7.taxi.br" }
  ],
  "vars": {
    "EMAIL_AVISOS": "atendimento@g7.taxi.br",
    "EMAIL_REMETENTE": "reservas@iguacuexecutivetransfer.com.br",
    "ADMIN_EMAILS": "atendimento@g7.taxi.br,williangirotoo@gmail.com",
    "ACCESS_TEAM": "",
    "ACCESS_AUD": "",
    "TURNSTILE_SITEKEY": ""
  },
  "observability": { "enabled": true },
  // Versoes de teste (ramos diferentes de main). Usam o mesmo banco; os pedidos de teste
  // ficam marcados com o endereco de teste (campo "origem") e podem ser cancelados no painel.
  "previews": {
    "vars": {
      "EMAIL_AVISOS": "atendimento@g7.taxi.br",
      "EMAIL_REMETENTE": "reservas@iguacuexecutivetransfer.com.br",
      "ADMIN_EMAILS": "atendimento@g7.taxi.br,williangirotoo@gmail.com",
      "ACCESS_TEAM": "",
      "ACCESS_AUD": "",
      "TURNSTILE_SITEKEY": ""
    },
    "d1_databases": [
      { "binding": "DB", "database_id": "c113f678-3e0f-4caa-af30-e41cfe39784e" }
    ],
    "send_email": [
      { "name": "AVISOS", "destination_address": "atendimento@g7.taxi.br" }
    ]
  }
}
